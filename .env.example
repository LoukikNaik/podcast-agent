# Used by PodClipper. Codex uses your separate `codex login` session.
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash
LLM_API_KEY=

# Optional: only needed when telegram = true in agent.toml.
# Create a bot with @BotFather. Setup can find your chat after you send /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: only used when instagram = true. Connect with ./run.sh instagram-login.
INSTAGRAM_USER=
INSTAGRAM_PASS=
